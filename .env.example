# Robot Fix — ortam değişkenleri ÖRNEĞİ
# Gerçek değerler .env.local içine yazılır ve git'e GİRMEZ.
# Bu dosyaya asla gerçek anahtar yazılmaz.

# --- Site ---
# Kanonik adres (metadata, canonical, sitemap, OG için).
NEXT_PUBLIC_SITE_URL=http://localhost:3434

# --- WhatsApp (ana dönüşüm kanalı) ---
# Bilgi dosyası §8: numara kod içine gömülmez, ayarlardan yönetilir.
#
# ASIL KAYNAK `site_settings.whatsapp_phone` SÜTUNUDUR — bu env değişkeni yalnız
# o tablo okunamadığında devreye giren YEDEKTİR (`lib/site-config.ts` önce
# tabloya bakar, boşsa env'e düşer). Numarayı değiştirmek için doğru yer
# yönetim panelidir; burası değil.
#
# Numara İŞLETME TARAFINDAN DOĞRULANDI (2026-08-27): 0552 426 16 16.
# Artık bir varsayım değildir; eski TODO(business) işareti kaldırıldı.
#
# Boş bırakılırsa WhatsApp butonları hiç gösterilmez (bozuk bağlantı üretilmez).
NEXT_PUBLIC_WHATSAPP_PHONE=+905524261616

# --- Supabase ---
# Kurulum adımları: docs/supabase-setup.md
# Boş bırakılırsa site çalışır ama katalog verisi gelmez; veri katmanı
# "not_configured" döndürür ve /veri-kontrol bunu açıkça gösterir.

# Panel → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Panel → Project Settings → API Keys → anon / public.
# Tarayıcıya gömülür; güvenlidir çünkü RLS ile sınırlıdır.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Panel → Project Settings → API Keys → service_role.
# RLS'İ ATLAR. Yalnız sunucuda kullanılır; ASLA NEXT_PUBLIC_ öneki ALMAZ.
SUPABASE_SERVICE_ROLE_KEY=
# Doğrudan Postgres bağlantısı — YALNIZ migrasyon ve veritabanı testleri için.
# Panel → Project Settings → Database → Connection string
#
# Başka projelerden `DATABASE_URL` adını arıyorsanız: bu değişken odur. Ad
# bilinçli olarak `SUPABASE_DB_URL`; hangi veritabanına gittiği adından okunsun
# diye. Yeniden adlandırmayın — scripts/, docs/ ve testler bu adı kullanır.
#
# BAĞLANTI HAVUZU (pooling) — bu değişken Vercel'de TANIMLANMAZ.
# Uygulama çalışma anında Postgres'e TEL PROTOKOLÜYLE BAĞLANMAZ; @supabase/supabase-js
# üzerinden HTTPS/PostgREST konuşur. Bu yüzden sunucusuz ortamın klasik
# "bağlantı tükenmesi" sorunu bu projede YOKTUR ve pgbouncer ayarı gerekmez.
# Ayrıntı ve ileride doğrudan Postgres istemcisi eklenirse ne yapılacağı:
# docs/supabase-setup.md → "Bağlantı havuzu".
SUPABASE_DB_URL=

# --- Auth ---
# NEXTAUTH_SECRET benzeri bir imzalama sırrı YOKTUR ve gerekmez: oturum
# Supabase Auth tarafından yönetilir, çerezleri Supabase imzalar (mimari kararı:
# CLAUDE.md — "kendi parola/oturum kodumuz yazılmaz"). Yönetici parolaları
# auth.users içinde Supabase tarafından hash'lenir; bu depoda parola saklanmaz.

# --- Analitik (Faz 7'de gerekli) ---
# Boş bırakılırsa analytics YÜKLENMEZ (KVKK onayı + ölçüm kimliği gelene kadar).
# TODO(business): GA4 ölçüm kimliği sağlanınca doldurulacak.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Demo/örnek ürünler ---
# "true" ise [ÖRNEK] işaretli taslak ürünler arayüzde görünür (yalnız geliştirme/önizleme).
# Üretimde daima boş veya "false" olmalıdır.
NEXT_PUBLIC_SHOW_DEMO_PRODUCTS=true
